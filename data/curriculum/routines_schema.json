{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADHD Daily Routine Schema",
  "description": "Schema chuẩn hóa cho nhiệm vụ sinh hoạt đời thường có khóa timeline và minh chứng thị giác",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9_]+$": {
      "type": "object",
      "required": [
        "id",
        "timeline_slot",
        "slot_time",
        "title",
        "catName",
        "icon",
        "reward",
        "steps"
      ],
      "properties": {
        "id": { "type": "string" },
        "timeline_slot": {
          "type": "string",
          "enum": ["morning", "afternoon", "evening", "night"]
        },
        "slot_time": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "title": { "type": "string" },
        "catName": { "type": "string" },
        "icon": { "type": "string" },
        "reward": { "type": "integer", "minimum": 10 },
        "target_photo_tag": { "type": "string" },
        "adhd_scaffolding_notes": {
          "type": "object",
          "properties": {
            "working_memory_pitfall": { "type": "string" },
            "executive_function_scaffolding": { "type": "string" },
            "visual_or_concrete_aid": { "type": "string" }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["step_id", "badge", "atomic_instruction", "ui_type", "is_milestone", "dopamine_points"],
            "properties": {
              "step_id": { "type": "integer" },
              "badge": { "type": "string" },
              "action_verb": { "type": "string" },
              "atomic_instruction": { "type": "string" },
              "ui_type": {
                "type": "string",
                "enum": ["single_choice", "checkbox", "highlight", "text_input", "photo_proof"]
              },
              "is_milestone": { "type": "boolean" },
              "requires_parent_check": { "type": "boolean" },
              "duration_sec": { "type": "integer" },
              "dopamine_points": { "type": "integer" },
              "hints": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
