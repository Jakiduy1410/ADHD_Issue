{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GDPT 2018 Primary School Benchmark Exercises",
  "description": "Standardized 25 benchmark exercises for Grade 1-5 ADHD micro-task intervention testing",
  "type": "object",
  "required": [
    "version",
    "framework",
    "total_exercises",
    "exercises"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "framework": {
      "type": "string",
      "enum": [
        "Chương trình GDPT 2018 (Thông tư 32/2018/TT-BGDĐT)"
      ]
    },
    "total_exercises": {
      "type": "integer",
      "enum": [
        25
      ]
    },
    "exercises": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": [
          "id",
          "grade",
          "subject",
          "category",
          "topic",
          "difficulty",
          "original_text",
          "ground_truth_steps",
          "final_answer",
          "adhd_scaffolding_notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G[1-5]_(MATH|VIET|MCQ|ENG)_[0-9]{2}$"
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "subject": {
            "type": "string",
            "enum": [
              "Toán",
              "Tiếng Việt",
              "Khoa học & Tự nhiên xã hội",
              "Tiếng Anh"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "Toán lời văn",
              "Tiếng Việt / Đọc hiểu",
              "Trắc nghiệm nhiều câu ABCD",
              "Tiếng Anh tiểu học"
            ]
          },
          "topic": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "Cơ bản (Nhận biết/Thông hiểu)",
              "Vận dụng",
              "Vận dụng cao"
            ]
          },
          "estimated_duration_min": {
            "type": "integer",
            "minimum": 3,
            "maximum": 20
          },
          "original_text": {
            "type": "string"
          },
          "options": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "A": {
                "type": "string"
              },
              "B": {
                "type": "string"
              },
              "C": {
                "type": "string"
              },
              "D": {
                "type": "string"
              }
            },
            "required": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "distractor_analysis": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "A": {
                "type": "string"
              },
              "B": {
                "type": "string"
              },
              "C": {
                "type": "string"
              },
              "D": {
                "type": "string"
              }
            }
          },
          "ground_truth_steps": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "step_number",
                "instruction",
                "mathematical_or_logical_goal",
                "intermediate_output"
              ],
              "properties": {
                "step_number": {
                  "type": "integer"
                },
                "instruction": {
                  "type": "string"
                },
                "mathematical_or_logical_goal": {
                  "type": "string"
                },
                "intermediate_output": {
                  "type": [
                    "string",
                    "number",
                    "object"
                  ]
                }
              }
            }
          },
          "final_answer": {
            "type": "object",
            "required": [
              "value",
              "unit",
              "normalized_display",
              "acceptable_variants"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "normalized_display": {
                "type": "string"
              },
              "acceptable_variants": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "adhd_scaffolding_notes": {
            "type": "object",
            "required": [
              "working_memory_pitfall",
              "executive_function_scaffolding",
              "visual_or_concrete_aid"
            ],
            "properties": {
              "working_memory_pitfall": {
                "type": "string"
              },
              "executive_function_scaffolding": {
                "type": "string"
              },
              "visual_or_concrete_aid": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
